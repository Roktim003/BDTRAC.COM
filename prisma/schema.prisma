// BDTRAC — data layer (Part 2). PostgreSQL via Prisma 7.
// Prisma 7 rules (see CLAUDE.md §4): the generator is `prisma-client` with an
// explicit output, the datasource carries NO url (connection lives in
// prisma.config.ts), and the runtime client is built with the @prisma/adapter-pg
// driver adapter in src/lib/prisma.ts. Money is always whole BDT (Int).
// The legacy Postgres doc-store in src/lib/db.ts still serves the current
// storefront routes; these models are the target schema for the migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum ProductCategory {
  HEAVYWEIGHT_TEE
  BOXY_HOODIE
  CARGO_TROUSER
  MONSOON_SHELL_JACKET
}

enum FitType {
  REGULAR
  BOXY
  OVERSIZED
  RELAXED
  TAPERED
  STRAIGHT
}

enum ApparelSize {
  S
  M
  L
  XL
  XXL
}

model Product {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             String
  category          ProductCategory
  /// Fabric weight in grams per square metre (BDTRAC range: 320–480).
  gsmWeight         Int
  fabricComposition String
  fitType           FitType
  /// Whole taka. No paisa/floats anywhere in the money path.
  basePriceBdt      Int
  images            String[]
  /// Editorial drop label, e.g. "DROP-001" or "MONSOON-EDIT". Null = evergreen.
  dropTag           String?
  isActive          Boolean         @default(true)
  variants          ProductVariant[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([category, isActive])
}

model ProductVariant {
  id         String      @id @default(cuid())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  size       ApparelSize
  color      String
  sku        String      @unique
  stockCount Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum DeliveryZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum CourierProvider {
  PATHAO
  REDX
  STEADFAST
  PAPERFLY
  OTHER
}

model Order {
  id             String          @id @default(cuid())
  /// Human-facing number, e.g. "TRAC-1024". Generated by the order service.
  orderNumber    String          @unique
  customerName   String
  /// Canonical BD mobile, always stored normalized: +8801XXXXXXXXX.
  phone          String
  district       String
  address        String
  deliveryZone   DeliveryZone
  shippingFeeBdt Int
  subtotalBdt    Int
  discountBdt    Int             @default(0)
  totalBdt       Int
  paymentMethod  PaymentMethod   @default(COD)
  paymentStatus  PaymentStatus   @default(PENDING)
  orderStatus    OrderStatus     @default(PENDING)
  courierProvider CourierProvider?
  trackingCode   String?
  items          OrderItem[]
  smsLogs        SmsLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([phone])
  @@index([orderStatus, createdAt])
}

model OrderItem {
  id           String         @id @default(cuid())
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  variantId    String
  quantity     Int
  /// Price captured at order time (whole BDT) — never re-read from the product.
  unitPriceBdt Int

  @@index([orderId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// SMS notifications
// ---------------------------------------------------------------------------

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model SmsLog {
  id        String    @id @default(cuid())
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  /// Canonical BD mobile, normalized: +8801XXXXXXXXX.
  phone     String
  message   String
  /// Gateway name as sent, e.g. "GREENWEB", "BULKSMSBD", "SSL_WIRELESS".
  provider  String
  status    SmsStatus @default(QUEUED)
  createdAt DateTime  @default(now())

  @@index([orderId])
  @@index([phone])
}
