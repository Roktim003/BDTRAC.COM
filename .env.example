# TRAC storefront — environment variables (copy to .env.local / host env)
# REQUIRED in production (the app fails closed without them — Phase 12):
ADMIN_PASSWORD=          # password for /admin (no fallback in production)
AUTH_SECRET=             # long random string signing session/admin cookies
# Production data (Phase 13): Postgres connection string (Supabase or
# Neon). When set, ALL stores persist in Postgres; when unset, local
# .data/ JSON files are used (development).
DATABASE_URL=
# Optional:
NEXT_PUBLIC_SITE_URL=https://www.bdtrac.com   # canonical origin for SEO
# Password-reset email via Resend (both required to enable delivery;
# without them reset links are recorded in the users store outbox):
RESEND_API_KEY=
MAIL_FROM=TRAC <no-reply@bdtrac.com>

# Part 5 — SMS (dispatcher logs to SmsLog; without credentials it runs
# log-only and sends nothing):
SMS_PROVIDER=ssl-wireless            # or bulksmsbd
SSL_WIRELESS_API_TOKEN=
SSL_WIRELESS_SID=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# Part 5 — couriers (zone routing: Inside Dhaka -> Steadfast, Outside ->
# Pathao; COURIER_FALLBACK=REDX takes over when the primary is unset):
COURIER_DEFAULT=
COURIER_FALLBACK=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_ACCESS_TOKEN=
# Part 5 — payment webhooks (/api/payments/webhook?provider=...):
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=
NAGAD_PUBLIC_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
